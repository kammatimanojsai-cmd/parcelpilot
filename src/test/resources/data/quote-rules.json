[
  { "name": "same day only within a city",
    "request": { "origin": "560001", "destination": "110001", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "SAME_DAY" },
    "expect": { "error": "SAME_DAY_UNAVAILABLE", "kind": "RULE" } },
  { "name": "same day closes at 11:00",
    "bookedAt": "2026-10-22T11:01",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "SAME_DAY" },
    "expect": { "error": "SAME_DAY_CUTOFF_PASSED", "kind": "RULE" } },
  { "name": "no same day on a Sunday",
    "bookedAt": "2026-10-25T09:00",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "SAME_DAY" },
    "expect": { "error": "SAME_DAY_CUTOFF_PASSED", "kind": "RULE" } },
  { "name": "no same day on a national holiday",
    "bookedAt": "2026-08-15T09:00",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "SAME_DAY" },
    "expect": { "error": "SAME_DAY_CUTOFF_PASSED", "kind": "RULE" } },
  { "name": "cash on delivery needs a value",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD", "cod": true, "declaredPaise": 0 },
    "expect": { "error": "COD_VALUE_REQUIRED", "kind": "RULE" } },
  { "name": "cash on delivery is capped at 50000",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD", "cod": true, "declaredPaise": 5000001 },
    "expect": { "error": "COD_LIMIT_EXCEEDED", "kind": "RULE" } },
  { "name": "prepaid parcels may be worth more than the COD cap",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD", "cod": false, "declaredPaise": 5000001 },
    "expect": { "zone": "LOCAL" } },
  { "name": "declared value above 2 lakh",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD", "declaredPaise": 20000001 },
    "expect": { "error": "DECLARED_VALUE_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "negative declared value",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD", "declaredPaise": -1 },
    "expect": { "error": "DECLARED_VALUE_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "weightless parcel",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 0, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD" },
    "expect": { "error": "WEIGHT_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "over 50 kg",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 50001, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD" },
    "expect": { "error": "WEIGHT_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "a side longer than 150 cm",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 151, "widthCm": 10, "heightCm": 10, "service": "STANDARD" },
    "expect": { "error": "DIMENSION_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "a zero-length side",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 0, "heightCm": 10, "service": "STANDARD" },
    "expect": { "error": "DIMENSION_OUT_OF_RANGE", "kind": "INVALID" } },
  { "name": "length plus girth over 300 cm",
    "request": { "origin": "560001", "destination": "560034", "weightGrams": 500, "lengthCm": 30, "widthCm": 150, "heightCm": 60, "service": "STANDARD" },
    "expect": { "error": "OVERSIZE", "kind": "RULE" } },
  { "name": "length plus girth of exactly 300 cm is accepted",
    "request": { "origin": "110001", "destination": "682001", "weightGrams": 50000, "lengthCm": 50, "widthCm": 100, "heightCm": 50, "service": "EXPRESS" },
    "expect": { "zone": "NATIONAL", "totalPaise": 956838 } },
  { "name": "pin code cannot start with 0",
    "request": { "origin": "012345", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD" },
    "expect": { "error": "INVALID_PINCODE", "kind": "INVALID" } },
  { "name": "pin code with spaces around it is accepted",
    "request": { "origin": " 560001 ", "destination": "560034", "weightGrams": 500, "lengthCm": 10, "widthCm": 10, "heightCm": 10, "service": "STANDARD" },
    "expect": { "zone": "LOCAL", "totalPaise": 4626 } }
]

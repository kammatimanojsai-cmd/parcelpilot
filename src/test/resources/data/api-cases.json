[
  {
    "name": "quote: same city, first slab",
    "method": "POST",
    "path": "/api/quotes",
    "body": {
      "originPincode": "500001",
      "destinationPincode": "500032",
      "weightGrams": 400,
      "lengthCm": 20,
      "widthCm": 15,
      "heightCm": 5,
      "service": "STANDARD",
      "cashOnDelivery": false,
      "declaredValue": 0
    },
    "status": 200,
    "expect": {
      "$.zone": "LOCAL",
      "$.zoneLabel": "Same city",
      "$.chargeableWeightGrams": 500,
      "$.totalPaise": 4626,
      "$.total": "₹46.26",
      "$.charges.length()": 3,
      "$.charges[0].code": "FREIGHT",
      "$.charges[1].amount": "₹4.20",
      "$.charges[2].code": "GST",
      "$.eta.pickupDate": "2026-10-22",
      "$.eta.estimatedDelivery": "2026-10-23",
      "$.eta.transitDays": 1
    }
  },
  {
    "name": "quote: COD and insurance lines",
    "method": "POST",
    "path": "/api/quotes",
    "body": {
      "originPincode": "400001",
      "destinationPincode": "110001",
      "weightGrams": 4500,
      "lengthCm": 45,
      "widthCm": 35,
      "heightCm": 25,
      "service": "EXPRESS",
      "cashOnDelivery": true,
      "declaredValue": 50000
    },
    "status": 200,
    "expect": {
      "$.zone": "NATIONAL",
      "$.volumetricWeightGrams": 7875,
      "$.chargeableWeightGrams": 8000,
      "$.charges.length()": 5,
      "$.charges[2].code": "COD_FEE",
      "$.charges[2].amountPaise": 100000,
      "$.charges[3].code": "INSURANCE",
      "$.totalPaise": 305035,
      "$.total": "₹3,050.35",
      "$.eta.estimatedDelivery": "2026-10-26"
    }
  },
  {
